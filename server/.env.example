# Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/bookmyshow_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bookmyshow_app

# JWT Secret for Passport.js
JWT_SECRET=super-secret-bookmyshow-key-2026

# Node Environment (development | production | test)
NODE_ENV=development

# Client Origin (for CORS)
CLIENT_URL=http://localhost:5173
